# Valori pubblici dell’app web Firebase. Non sono chiavi private.
# Se li lasci vuoti, l’app funziona solo su questo dispositivo e l’account dice «da attivare».
# Copia questo file in .env solo se avvii l’app sul computer con npm run dev.
# Per il sito pubblico, gli stessi nomi vanno nelle variabili di GitHub Actions.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
